# =============================================================================
# Configuration statique Traefik.
# Docs : https://doc.traefik.io/traefik/reference/static-configuration/file/
# =============================================================================
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: "@@TRAEFIK_LOG_LEVEL@@"

accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  bufferingSize: 0

api:
  dashboard: true

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
  # Entrée TCP Minecraft. Un seul routeur TCP écoute ici : Velocity.
  minecraft:
    address: ":25565/tcp"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: "@@PROXY_NETWORK@@"
    watch: true
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: "@@ACME_EMAIL@@"
      storage: "/acme/acme.json"
      caServer: "@@ACME_CA_SERVER@@"
      httpChallenge:
        entryPoint: web
