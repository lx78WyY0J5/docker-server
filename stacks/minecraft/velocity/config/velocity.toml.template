config-version = "2.9"

bind = "0.0.0.0:25565"
motd = "__MOTD__"
show-max-players = 500
online-mode = __ONLINE_MODE__
force-key-authentication = __ONLINE_MODE__
# Traefik termine le TCP sur 25565 : Velocity voit l'IP du conteneur Traefik,
# pas celle du joueur. Laisser false, sinon tous les joueurs Java sont kickés.
prevent-client-proxy-connections = false
player-info-forwarding-mode = "modern"
forwarding-secret-file = "forwarding.secret"
announce-forge = false
kick-existing-players = true
sample-players-in-ping = false
enable-player-address-logging = true

[ping-passthrough]
version = true
players = true
description = true
favicon = true
modinfo = true

[packet-limiter]
interval = 7.0
packets-per-second = -1.0
bytes-per-second = -1.0
decompressed-bytes-per-second = 5242880.0

[servers]
hub = "mc-hub:25565"
test = "mc-test:25565"
survie = "mc-survie:25565"
anarchie = "mc-anarchie:25565"
rpg = "mc-rpg:25565"
skyblock = "mc-skyblock:25565"
creatif = "mc-creatif:25565"
opprison = "mc-opprison:25565"

try = [
    "hub"
]

[forced-hosts]
"hub.__DOMAIN__" = ["hub"]
"test.__DOMAIN__" = ["test"]
"survie.__DOMAIN__" = ["survie"]
"anarchie.__DOMAIN__" = ["anarchie"]
"rpg.__DOMAIN__" = ["rpg"]
"skyblock.__DOMAIN__" = ["skyblock"]
"creatif.__DOMAIN__" = ["creatif"]
"opprison.__DOMAIN__" = ["opprison"]

[advanced]
compression-threshold = 256
compression-level = -1
login-ratelimit = 3000
connection-timeout = 5000
read-timeout = 30000
haproxy-protocol = false
tcp-fast-open = false
bungee-plugin-message-channel = true
show-ping-requests = false
failover-on-unexpected-server-disconnect = true
announce-proxy-commands = true
log-command-executions = true
log-player-connections = true
accepts-transfers = false
enable-reuse-port = false
command-rate-limit = 50
forward-commands-if-rate-limited = true
kick-after-rate-limited-commands = 0
tab-complete-rate-limit = 10
kick-after-rate-limited-tab-completes = 0

[query]
enabled = false
port = 25565
map = "Velocity"
show-plugins = false
