# =============================================================================
# Override mailcow : placé dans $MAILCOW_DIR/docker-compose.override.yml
# Généré par scripts/mail-integrate.sh - ne pas éditer sur place.
# =============================================================================
services:
  nginx-mailcow:
    networks:
      - mailcow-network
      - proxy
    # Traefik publie déjà 80/443 : on retire les ports de mailcow.
    ports: !reset []
    labels:
      traefik.enable: "true"
      traefik.docker.network: "@@PROXY_NETWORK@@"

      # Interface d'administration : mail.<domaine>
      traefik.http.routers.mailcow.rule: "Host(`mail.@@DOMAIN@@`)"
      traefik.http.routers.mailcow.entrypoints: "websecure"
      traefik.http.routers.mailcow.tls.certResolver: "letsencrypt"
      traefik.http.routers.mailcow.middlewares: "secure-headers@file"
      traefik.http.routers.mailcow.service: "mailcow"
      traefik.http.services.mailcow.loadbalancer.server.port: "443"
      traefik.http.services.mailcow.loadbalancer.server.scheme: "https"
      traefik.http.services.mailcow.loadbalancer.serversTransport: "mailcow@docker"
      traefik.http.serversTransports.mailcow.insecureSkipVerify: "true"

      # Webmail : redirection vers SOGo
      traefik.http.routers.mailcow-webmail.rule: "Host(`webmail.@@DOMAIN@@`) || Host(`mails.@@DOMAIN@@`)"
      traefik.http.routers.mailcow-webmail.entrypoints: "websecure"
      traefik.http.routers.mailcow-webmail.tls.certResolver: "letsencrypt"
      traefik.http.routers.mailcow-webmail.middlewares: "mailcow-webmail,secure-headers@file"
      traefik.http.routers.mailcow-webmail.service: "mailcow"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.regex: "^https://(webmail|mails)[.]@@DOMAIN_REGEX@@/(.*)$"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.replacement: "https://mail.@@DOMAIN@@/SOGo/$${1}"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.permanent: "true"

networks:
  proxy:
    external: true
    name: "@@PROXY_NETWORK@@"
